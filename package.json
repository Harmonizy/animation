{
  "name": "cinematic-animation-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Animation-as-Code studio foundation: data-driven scenes, deterministic evaluation, pluggable rendering.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "capture": "playwright test --project=capture",
    "build:harmonie": "node scripts/build-harmonie.mjs",
    "build:episode": "node scripts/build-episode.mjs",
    "render:episode": "node scripts/render-episode.mjs",
    "audio:episode": "python3 scripts/episode-audio.py",
    "narration:episode": "node scripts/episode-narration.mjs",
    "narration:check": "node scripts/narration-check.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "gsap": "3.15.1",
    "pixi.js": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
